{
  "name": "train-assistant-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node scripts/build.js",
    "build:ios": "node scripts/build.js --ios",
    "ios:add": "npm run build && cap add ios",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "test": "node --test"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
